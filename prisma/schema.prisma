generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model ParentTask {
  id                    String     @id @default(uuid())
  name                  String
  general_notes         String?
  total_cumulative_time Int        @default(0)
  created_at            DateTime   @default(now())
  subTasks              SubTask[]
}

model SubTask {
  id                    String     @id @default(uuid())
  parent_task_id        String
  name                  String
  total_cumulative_time Int        @default(0)
  created_at            DateTime   @default(now())
  parentTask            ParentTask @relation(fields: [parent_task_id], references: [id], onDelete: Cascade)
  sessions              Session[]
}

model Session {
  id            String    @id @default(uuid())
  sub_task_id   String
  start_time    DateTime
  end_time      DateTime?
  duration      Int       @default(0)
  session_notes String?
  subTask       SubTask   @relation(fields: [sub_task_id], references: [id], onDelete: Cascade)
}
