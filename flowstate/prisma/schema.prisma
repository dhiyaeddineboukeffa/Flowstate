generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String       @id @default(uuid())
  username   String       @unique
  created_at DateTime     @default(now())
  tasks      ParentTask[]
}

model ParentTask {
  id                    String          @id @default(uuid())
  user_id               String?
  name                  String
  general_notes         String?
  total_cumulative_time Int             @default(0)
  created_at            DateTime        @default(now())
  user                  User?           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subTasks              SubTask[]
  checklists            ChecklistItem[]
}

model ChecklistItem {
  id             String     @id @default(uuid())
  parent_task_id String
  text           String
  done           Boolean    @default(false)
  parentTask     ParentTask @relation(fields: [parent_task_id], references: [id], onDelete: Cascade)
}

model SubTask {
  id                    String     @id @default(uuid())
  parent_task_id        String
  name                  String
  total_cumulative_time Int        @default(0)
  created_at            DateTime   @default(now())
  parentTask            ParentTask @relation(fields: [parent_task_id], references: [id], onDelete: Cascade)
  sessions              Session[]
}

model Session {
  id                      String    @id @default(uuid())
  sub_task_id             String
  start_time              DateTime
  end_time                DateTime?
  duration                Int       @default(0)
  session_notes           String?
  is_paused               Boolean   @default(false)
  last_paused_at          DateTime?
  accumulated_paused_time Int       @default(0)
  subTask                 SubTask   @relation(fields: [sub_task_id], references: [id], onDelete: Cascade)
}
